{
  "manifest_version": 3,
  "name": "Ahamove AWB – Phiếu lưu kho",
  "short_name": "Ahamove AWB",
  "version": "1.1.0",
  "description": "Tạo AWB (A6) có QR + barcode từ pop-up chi tiết đơn trên Ahamove Warehouse để in dán lên hàng.",
  "action": {
    "default_title": "Tạo AWB cho đơn đang mở",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage"]
}
